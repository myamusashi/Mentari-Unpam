{
  "manifest_version": 3,
  "name": "Mentari Mod v1.9",
  "version": "1.9",
  "description": "Ekstensi untuk meningkatkan pengalaman belajar di MENTARI UNPAM dengan fitur pelacakan forum, asisten AI, bantuan quiz, dan manajemen presensi.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mentari-mod@lukman754.github.io",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mentari Mod",
    "default_icon": "icon.png"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://mentari.unpam.ac.id/*",
    "https://my.unpam.ac.id/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.github.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mentari.unpam.ac.id/*"
      ],
      "exclude_matches": [
        "https://mentari.unpam.ac.id/login*"
      ],
      "js": [
        "ompProvider.js",
        "apiKeyManager.js",
        "content.js",
        "gemini.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/*"
      ],
      "js": [
        "home.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/u-courses/*/exam/*"
      ],
      "js": [
        "ompProvider.js",
        "quiz.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/u-courses/*/kuesioner/*"
      ],
      "js": [
        "kuisioner.js"
      ]
    },
    {
      "matches": [
        "https://mentari.unpam.ac.id/u-courses/*/forum/*/topics/*"
      ],
      "js": [
        "ompProvider.js",
        "discus.js"
      ]
    },
    {
      "matches": [
        "https://my.unpam.ac.id/*"
      ],
      "exclude_matches": [
        "https://my.unpam.ac.id/login*"
      ],
      "js": [
        "presensi.js",
        "QuickSurvey.js"
      ]
    },
    {
      "matches": [
        "https://my.unpam.ac.id/login*",
        "https://mentari.unpam.ac.id/login*"
      ],
      "js": [
        "pw.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "token.js",
        "apiKeyManager.js",
        "ompProvider.js"
      ],
      "matches": [
        "https://mentari.unpam.ac.id/*",
        "https://my.unpam.ac.id/*"
      ]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
